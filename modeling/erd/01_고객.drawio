.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_member" target="t_member_grade_history"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_member_login" value="member_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=0.0;exitY=0.8987;exitDx=0;exitDy=0;entryX=1.0;entryY=0.15;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_member" target="t_member_login_history"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_terms_agreement" value="(terms_id, terms_type)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=1.0;exitY=0.4245;exitDx=0;exitDy=0;entryX=0.0;entryY=0.7075;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_terms" target="t_member_terms_agreement"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_member_agreement" value="member_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_member" target="t_member_terms_agreement"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_member_body" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=14;endSize=14;exitX=1.0;exitY=0.0949;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_member" target="t_member_body_profile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="330"/><mxPoint x="1040" y="120"/></Array></mxGeometry></mxCell><mxCell id="e_member_auth" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=1.0;exitY=0.3797;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_member" target="t_member_auth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="420"/><mxPoint x="1060" y="346"/></Array></mxGeometry></mxCell><mxCell id="e_member_address" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=1.0;exitY=0.6962;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3216;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_member" target="t_address"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="520"/><mxPoint x="1080" y="600"/></Array></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;고객 영역 ERD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Oracle 기준 · IE(Crow's Foot) 표기 · &lt;span style=&quot;background-color:#dae8fc&quot;&gt;&amp;nbsp;핵심&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#d5e8d4&quot;&gt;&amp;nbsp;마스터&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#fff2cc&quot;&gt;&amp;nbsp;회원 종속&amp;nbsp;&lt;/span&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="600" y="30" width="420" height="50" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;표기&lt;/b&gt;&lt;br&gt;PK 기본키 / FK 외래키 / UK UNIQUE (UK가 여러 컬럼이면 복합 UNIQUE)&lt;br&gt;관계선: 부모 쪽 필수 1 또는 선택 1(FK가 NULL 허용), 자식 쪽 0..N 또는 0..1&lt;br&gt;타입 뒤 NULL은 NULL 허용&lt;br&gt;&lt;br&gt;&lt;b&gt;참고&lt;/b&gt;&lt;br&gt;· member_login_history.provider_type은 복사한 값이라 member_auth와 FK가 없다.&lt;br&gt;· member_terms_agreement는 (terms_id, terms_type) 복합 FK이며, 현재 유효한 기록(ended_at IS NULL)은 회원·약관 유형당 1건이다.&lt;br&gt;· address는 회원당 default_yn='Y'가 최대 1개이다 (함수 기반 UNIQUE 인덱스).&lt;br&gt;· member_body_profile은 member와 1:1이며 member_id가 PK이자 FK이다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="870" width="400" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
