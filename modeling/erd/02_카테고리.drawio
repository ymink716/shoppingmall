_category_r2"><mxGeometry x="230" width="190" height="26" as="geometry"/></mxCell><mxCell id="e_category_self" value="parent_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_category" target="t_category"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="103"/><mxPoint x="80" y="166"/></Array></mxGeometry></mxCell><mxCell id="e_category_pc" value="category_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_category" target="t_product_category"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="166"/><mxPoint x="680" y="244"/></Array></mxGeometry></mxCell><mxCell id="e_product_pc" value="product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_product" target="t_product_category"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;표기&lt;/b&gt;&lt;br&gt;PK 기본키 / FK 외래키 / UK UNIQUE (UK가 여러 컬럼이면 복합 UNIQUE)&lt;br&gt;관계선: 부모 쪽 필수 1 또는 선택 1(FK가 NULL 허용), 자식 쪽 0..N&lt;br&gt;타입 뒤 NULL은 NULL 허용. 회색 테이블은 다른 영역에서 정의(PK만 표시)&lt;br&gt;&lt;br&gt;&lt;b&gt;참고&lt;/b&gt;&lt;br&gt;· category는 자기 참조이며 최대 2단계이다. 부모는 최상위여야 한다(애플리케이션 검증).&lt;br&gt;· UNIQUE (parent_id, name): 같은 부모 아래 이름 중복 금지(최상위끼리도 포함).&lt;br&gt;· 상품은 parent_id IS NOT NULL인 2단계 카테고리에만 연결한다(애플리케이션 검증).&lt;br&gt;· product_category는 복합 PK이며, 별도 인덱스 (category_id, product_id)를 둔다.&lt;br&gt;· product_category.product_id의 FK 제약은 상품 영역에서 정의한다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="360" width="1060" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>