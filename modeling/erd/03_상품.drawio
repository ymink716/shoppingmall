int x="1100" y="301"/><mxPoint x="1100" y="400"/><mxPoint x="996" y="400"/></Array></mxGeometry></mxCell><mxCell id="e_product_sku" value="product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=0;exitY=0.12;exitDx=0;exitDy=0;entryX=1;entryY=0.26;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_product" target="t_sku"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e_product_detail" value="product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=14;endSize=14;exitX=1;exitY=0.12;exitDx=0;exitDy=0;entryX=0;entryY=0.136;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_product" target="t_product_detail"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e_product_image" value="product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_product" target="t_product_image"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e_product_category" value="product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_product" target="t_product_category"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="753"/><mxPoint x="1100" y="911"/></Array></mxGeometry></mxCell><mxCell id="e_category_pc" value="category_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_category" target="t_product_category"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;표기&lt;/b&gt;&lt;br&gt;PK 기본키 / FK 외래키 / UK UNIQUE (UK가 여러 컬럼이면 복합 UNIQUE)&lt;br&gt;관계선: 부모 쪽 필수 1, 자식 쪽 0..N 또는 0..1&lt;br&gt;타입 뒤 NULL은 NULL 허용. 회색 테이블은 카테고리 영역에서 정의(PK만 표시)&lt;br&gt;&lt;br&gt;&lt;b&gt;참고&lt;/b&gt;&lt;br&gt;· 판매자는 brand를 통해 확인하므로 product에 seller_id가 없다.&lt;br&gt;· product_detail은 product와 1:0..1이며 product_id가 PK이자 FK이다.&lt;br&gt;· UNIQUE (brand_id, model_number): 같은 브랜드에서 같은 품번의 상품 페이지는 하나뿐이다.&lt;br&gt;· sku UNIQUE (product_id, color_name, size_name, extra_option_value): 같은 옵션 조합의 중복 방지.&lt;br&gt;· 품절은 저장하지 않고 stock_qty에서 계산한다. sale_yn은 판매 허용 여부이다.&lt;br&gt;· product_image는 image_type=MAIN인 행이 상품당 최대 1개이다(함수 기반 UNIQUE 인덱스).&lt;br&gt;· product_category.product_id → product FK는 이 영역에서 정의한다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="440" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>