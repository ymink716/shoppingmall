---
title: 2회차 카테고리 ERD
---
erDiagram
    category["표준 카테고리 category"] {
        NUM category_id PK "카테고리번호"
        NUM parent_category_id FK "상위카테고리번호 (선택)"
        CODE category_code UK "카테고리코드"
        NAME category_name UK "카테고리명"
        INT sort_order "정렬순서"
        YN use_yn "사용여부"
    }
    display_category["전시 카테고리 display_category"] {
        NUM display_category_id PK "전시카테고리번호"
        NUM parent_display_category_id FK "상위전시카테고리번호 (선택)"
        CODE display_type_cd "전시유형코드"
        NAME display_category_name "전시카테고리명"
        INT sort_order "정렬순서"
        YN display_yn "노출여부"
        DT display_start_at "노출시작일시 (선택)"
        DT display_end_at "노출종료일시 (선택)"
        NAME image_url "대표이미지URL (선택)"
    }
    display_category_link["전시 카테고리 구성 display_category_link"] {
        NUM display_category_id PK, FK "전시카테고리번호"
        NUM category_id PK, FK "카테고리번호"
        YN include_sub_yn "하위포함여부"
        INT sort_order "정렬순서"
    }
    display_category_product["전시 카테고리 상품 display_category_product"] {
        NUM display_category_id PK, FK "전시카테고리번호"
        NUM product_id PK, FK "상품번호"
        INT sort_order "정렬순서"
    }
    category_attribute["카테고리 속성 (상품 회차) category_attribute"] {
        NUM category_id PK "카테고리번호"
        NUM attribute_id PK "속성번호"
    }
    product["상품 (상품 회차) product"] {
        NUM product_id PK "상품번호"
    }
    category |o..o{ category : "상위-하위"
    display_category |o..o{ display_category : "상위-하위"
    display_category ||--o{ display_category_link : "구성"
    category ||--o{ display_category_link : "구성"
    display_category ||--o{ display_category_product : "직접 지정"
    product ||--o{ display_category_product : "직접 지정"
    category ||..o{ product : "분류"
    category ||--o{ category_attribute : "속성 지정"
