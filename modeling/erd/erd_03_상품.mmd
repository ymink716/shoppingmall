---
title: 3회차 상품 ERD
---
erDiagram
    product["상품 product"] {
        NUM product_id PK "상품번호"
        NUM seller_id FK "판매자번호"
        NUM brand_id FK "브랜드번호"
        NUM category_id FK "카테고리번호"
        CODE seller_product_code UK "판매자상품코드 (선택)"
        NAME product_name "상품명"
        NAME product_summary "상품요약 (선택)"
        TEXT product_detail "상품상세설명 (선택)"
        CODE gender_cd "성별구분코드"
        CODE season_cd "시즌코드 (선택)"
        AMT list_price "정가"
        AMT sale_price "판매가"
        CODE tax_type_cd "과세구분코드"
        CODE product_status_cd "상품상태코드"
        DT sale_start_at "판매시작일시 (선택)"
        DT sale_end_at "판매종료일시 (선택)"
        INT max_order_qty "1회최대구매수량 (선택)"
    }
    product_option_group["상품 옵션 그룹 product_option_group"] {
        NUM option_group_id PK "옵션그룹번호"
        NUM product_id FK, UK "상품번호"
        NAME option_group_name UK "옵션그룹명"
        CODE option_type_cd "옵션유형코드"
        INT sort_order "정렬순서"
    }
    product_option_value["상품 옵션 값 product_option_value"] {
        NUM option_value_id PK "옵션값번호"
        NUM option_group_id FK, UK "옵션그룹번호"
        NAME option_value_name UK "옵션값명"
        CODE color_hex "색상코드 (선택)"
        INT sort_order "정렬순서"
    }
    product_item["단품 product_item"] {
        NUM item_id PK "단품번호"
        NUM product_id FK, UK "상품번호"
        CODE sku_code UK "단품코드"
        AMT additional_price "옵션추가금액"
        INT stock_qty "재고수량"
        CODE item_status_cd "단품판매상태코드"
        INT sort_order "정렬순서"
    }
    product_item_option["단품 옵션 구성 product_item_option"] {
        NUM item_id PK, FK "단품번호"
        NUM option_group_id PK, FK "옵션그룹번호"
        NUM option_value_id FK "옵션값번호"
    }
    product_image["상품 이미지 product_image"] {
        NUM image_id PK "이미지번호"
        NUM product_id FK "상품번호"
        NUM option_value_id FK "옵션값번호 (선택)"
        CODE image_type_cd "이미지유형코드"
        NAME image_url "이미지URL"
        INT sort_order "정렬순서"
    }
    attribute["속성 attribute"] {
        NUM attribute_id PK "속성번호"
        CODE attribute_type_cd UK "속성유형코드"
        NAME attribute_name UK "속성명"
        CODE input_type_cd "입력방식코드"
        NAME unit "단위 (선택)"
        YN use_yn "사용여부"
    }
    attribute_option["속성 선택값 attribute_option"] {
        NUM attribute_option_id PK "속성선택값번호"
        NUM attribute_id FK, UK "속성번호"
        NAME option_name UK "선택값명"
        INT sort_order "정렬순서"
    }
    category_attribute["카테고리 속성 category_attribute"] {
        NUM category_id PK, FK "카테고리번호"
        NUM attribute_id PK, FK "속성번호"
        YN required_yn "필수여부"
        INT sort_order "정렬순서"
    }
    product_attribute_value["상품 속성값 product_attribute_value"] {
        NUM product_id PK, FK "상품번호"
        NUM attribute_id PK, FK "속성번호"
        NUM attribute_option_id FK "속성선택값번호 (선택)"
        NAME attribute_value "속성값 (선택)"
    }
    product_size_measure["실측 사이즈 product_size_measure"] {
        NUM option_value_id PK, FK "옵션값번호"
        NUM attribute_id PK, FK "속성번호"
        DEC measure_value "측정값"
    }
    product_price_hist["상품 가격 이력 product_price_hist"] {
        NUM product_id PK, FK "상품번호"
        DT apply_start_at PK "적용시작일시"
        DT apply_end_at "적용종료일시"
        AMT list_price "정가"
        AMT sale_price "판매가"
        NAME change_reason "변경사유 (선택)"
    }
    product_item_stock_hist["단품 재고 이력 product_item_stock_hist"] {
        NUM stock_hist_id PK "재고이력번호"
        NUM item_id FK "단품번호"
        CODE change_type_cd "변동유형코드"
        INT change_qty "변동수량"
        INT after_qty "변동후수량"
        NUM order_item_id FK "참조주문상품번호 (선택)"
        NAME change_reason "변동사유 (선택)"
        DT changed_at "변동일시"
    }
    product_status_hist["상품 상태 이력 product_status_hist"] {
        NUM status_hist_id PK "상태이력번호"
        NUM product_id FK "상품번호"
        CODE before_status_cd "이전상태코드 (선택)"
        CODE after_status_cd "변경상태코드"
        NAME change_reason "변경사유 (선택)"
        CODE changed_by_type_cd "처리자구분코드"
        NUM changed_by_id "처리자ID (선택)"
        DT changed_at "변경일시"
    }
    brand["브랜드 (미설계) brand"] {
        NUM brand_id PK "브랜드번호"
    }
    category["표준 카테고리 (카테고리 회차) category"] {
        NUM category_id PK "카테고리번호"
    }
    display_category_product["전시 카테고리 상품 (카테고리 회차) display_category_product"] {
        NUM display_category_id PK "전시카테고리번호"
        NUM product_id PK "상품번호"
    }
    order_item["주문상품 (미설계) order_item"] {
        NUM order_item_id PK "주문상품번호"
    }
    seller["판매자 (미설계) seller"] {
        NUM seller_id PK "판매자번호"
    }
