    orders ||..o{ payment : "결제"
    order_seller ||..o{ shipment : "배송"
    order_item ||--o{ shipment_item : "배송상품"
    orders ||..o{ order_address_hist : "배송지 변경 이력"
    order_seller ||..o{ claim : "클레임"
    order_item ||--o{ claim_item : "클레임상품"
