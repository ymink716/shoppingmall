title: 4회차 장바구니·주문 ERD
---
erDiagram
    cart_item["장바구니상품 cart_item"] {
        NUM customer_id PK, FK "고객번호"
        NUM item_id PK, FK "단품번호"
        INT quantity "수량"
        DT added_at "담은일시"
    }
    orders["주문 orders"] {
        NUM order_id PK "주문번호"
        CODE order_no UK "주문공개번호"
        NUM customer_id FK "고객번호"
        CODE order_status_cd "주문상태코드"
        DT ordered_at "주문일시"
        DT paid_at "결제완료일시 (선택)"
        CODE order_channel_cd "주문경로코드"
        ENC orderer_name "주문자명 🔒"
        ENC orderer_mobile_no "주문자휴대폰번호 🔒"
        ENC recipient_name "수령인명 🔒"
        ENC recipient_mobile_no "수령인휴대폰번호 🔒"
        CODE zip_code "우편번호"
        NAME base_address "기본주소"
        ENC detail_address "상세주소 (선택) 🔒"
        NAME delivery_memo "배송요청사항 (선택)"
    }
    order_seller["판매자 주문 order_seller"] {
        NUM order_id PK, FK "주문번호"
        NUM seller_id PK, FK "판매자번호"
        AMT base_delivery_fee "기본배송비"
        AMT free_delivery_threshold "무료배송기준금액 (선택)"
        AMT delivery_fee "배송비"
        AMT remote_area_fee "추가배송비"
    }
    order_item["주문상품 order_item"] {
        NUM order_item_id PK "주문상품번호"
        NUM order_id FK "주문번호"
        NUM seller_id FK "판매자번호"
        NUM item_id FK "단품번호"
        NAME product_name "상품명"
        NAME brand_name "브랜드명"
        NAME option_text "옵션표시명 (선택)"
        CODE sku_code "단품코드"
        NAME product_image_url "대표이미지URL (선택)"
        AMT list_price "정가"
        AMT sale_price "판매가"
        AMT additional_price "옵션추가금액"
        INT quantity "수량"
        AMT point_use_amount "적립금사용금액"
        CODE order_item_status_cd "주문상품상태코드"
        DT confirmed_at "구매확정일시 (선택)"
    }
    order_item_discount["주문상품 할인 order_item_discount"] {
        NUM order_item_id PK, FK "주문상품번호"
        CODE discount_type_cd PK "할인유형코드"
        AMT discount_amount "할인금액"
        NUM customer_coupon_id FK "고객쿠폰번호 (선택)"
    }
    order_item_status_hist["주문상품 상태 이력 order_item_status_hist"] {
        NUM status_hist_id PK "상태이력번호"
        NUM order_item_id FK "주문상품번호"
        CODE before_status_cd "이전상태코드 (선택)"
        CODE after_status_cd "변경상태코드"
        NAME change_reason "변경사유 (선택)"
        CODE changed_by_type_cd "처리자구분코드"
        NUM changed_by_id "처리자ID (선택)"
        DT changed_at "변경일시"
    }
    claim["클레임 (클레임 회차) claim"] {
        NUM claim_id PK "클레임번호"
    }
    claim_item["클레임상품 (클레임 회차) claim_item"] {
        NUM claim_id PK "클레임번호"
