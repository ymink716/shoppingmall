    }
    customer["고객 (고객 회차) customer"] {
        NUM customer_id PK "고객번호"
    }
    customer_coupon["고객 쿠폰 (미설계) customer_coupon"] {
        NUM customer_coupon_id PK "고객쿠폰번호"
    }
    order_address_hist["주문 배송지 변경 이력 (결제·배송 회차) order_address_hist"] {
        NUM address_hist_id PK "배송지이력번호"
    }
    payment["결제 (결제·배송 회차) payment"] {
        NUM payment_id PK "결제번호"
    }
    product_item["단품 (상품 회차) product_item"] {
        NUM item_id PK "단품번호"
    }
    product_item_stock_hist["단품 재고 이력 (상품 회차) product_item_stock_hist"] {
        NUM stock_hist_id PK "재고이력번호"
    }
    seller["판매자 (미설계) seller"] {
        NUM seller_id PK "판매자번호"
    }
    shipment["배송 (결제·배송 회차) shipment"] {
        NUM shipment_id PK "배송번호"
    }
    shipment_item["배송상품 (결제·배송 회차) shipment_item"] {
        NUM shipment_id PK "배송번호"
        NUM order_item_id PK "주문상품번호"
    }
    order_item |o..o{ product_item_stock_hist : "주문 참조"
