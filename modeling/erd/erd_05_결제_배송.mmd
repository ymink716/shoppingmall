---
title: 5회차 결제·배송 ERD
---
erDiagram
    payment["결제 payment"] {
        NUM payment_id PK "결제번호"
        NUM order_id FK "주문번호"
        CODE payment_method_cd "결제수단코드"
        AMT payment_amount "결제금액"
        CODE payment_status_cd "결제상태코드"
        CODE pg_provider_cd UK "PG사코드 (선택)"
        CODE pg_payment_key UK "PG결제키 (선택)"
        DT requested_at "결제요청일시"
        DT approved_at "결제승인일시 (선택)"
    }
    payment_card["카드 결제 payment_card"] {
        NUM payment_id PK, FK "결제번호"
        CODE card_company_cd "카드사코드"
        CODE card_type_cd "카드구분코드 (선택)"
        CODE card_no_masked "마스킹카드번호"
        INT installment_months "할부개월수"
        CODE approval_no "카드승인번호 (선택)"
    }
    payment_vbank["가상계좌 결제 payment_vbank"] {
        NUM payment_id PK, FK "결제번호"
        CODE bank_cd "은행코드"
        ENC account_no "가상계좌번호 🔒"
        ENC depositor_name "입금자명 (선택) 🔒"
        DT deposit_due_at "입금기한일시"
        DT deposited_at "입금일시 (선택)"
    }
    payment_easy_pay["간편결제 payment_easy_pay"] {
        NUM payment_id PK, FK "결제번호"
        CODE easy_pay_provider_cd "간편결제사코드"
        CODE inner_method_cd "내부결제수단코드 (선택)"
    }
    payment_transaction["결제 거래 payment_transaction"] {
        NUM transaction_id PK "거래번호"
        NUM payment_id FK "결제번호"
        CODE transaction_type_cd "거래유형코드"
        AMT transaction_amount "거래금액"
        CODE result_cd "거래결과코드"
        CODE pg_transaction_no "PG거래번호 (선택)"
        NAME result_message "결과메시지 (선택)"
        DT requested_at "요청일시"
        DT responded_at "응답일시 (선택)"
    }
    shipment["배송 shipment"] {
        NUM shipment_id PK "배송번호"
        NUM order_id FK "주문번호"
        NUM seller_id FK "판매자번호"
        CODE shipment_type_cd "배송유형코드"
        CODE ship_from_type_cd "출고주체코드"
        CODE courier_cd "택배사코드 (선택)"
        CODE tracking_no "송장번호 (선택)"
        CODE shipment_status_cd "배송상태코드"
        DT shipped_at "출고일시 (선택)"
        DT delivered_at "배송완료일시 (선택)"
    }
    shipment_item["배송상품 shipment_item"] {
        NUM shipment_id PK, FK "배송번호"
        NUM order_item_id PK, FK "주문상품번호"
        INT quantity "수량"
    }
    shipment_tracking_hist["배송 추적 이력 shipment_tracking_hist"] {
        NUM tracking_hist_id PK "추적이력번호"
        NUM shipment_id FK "배송번호"
        CODE tracking_status_cd "추적상태코드"
        NAME courier_status_text "택배사상태명 (선택)"
        NAME location_name "위치명 (선택)"
        DT event_at "이벤트일시"
    }
    order_address_hist["주문 배송지 변경 이력 order_address_hist"] {
        NUM address_hist_id PK "배송지이력번호"
        NUM order_id FK "주문번호"
        ENC before_recipient_name "변경전수령인명 🔒"
        ENC before_recipient_mobile_no "변경전수령인휴대폰번호 🔒"
        CODE before_zip_code "변경전우편번호"
        NAME before_base_address "변경전기본주소"
        ENC before_detail_address "변경전상세주소 (선택) 🔒"
        NAME before_delivery_memo "변경전배송요청사항 (선택)"
        CODE changed_by_type_cd "처리자구분코드"
        NUM changed_by_id "처리자ID (선택)"
        DT changed_at "변경일시"
    }
    order_item["주문상품 (주문 회차) order_item"] {
        NUM order_item_id PK "주문상품번호"
    }
    order_seller["판매자 주문 (주문 회차) order_seller"] {
        NUM order_id PK "주문번호"
        NUM seller_id PK "판매자번호"
    }
    orders["주문 (주문 회차) orders"] {
        NUM order_id PK "주문번호"
    }
    orders ||..o{ payment : "결제"
    payment ||--o| payment_card : "카드"
    payment ||--o| payment_vbank : "가상계좌"
    payment ||--o| payment_easy_pay : "간편결제"
    payment ||..o{ payment_transaction : "거래"
    order_seller ||..o{ shipment : "배송"
    shipment ||--|{ shipment_item : "배송상품"
    order_item ||--o{ shipment_item : "배송상품"
    shipment ||..o{ shipment_tracking_hist : "추적 이력"
    orders ||..o{ order_address_hist : "배송지 변경 이력"
