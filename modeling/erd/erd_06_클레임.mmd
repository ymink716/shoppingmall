---
title: 6회차 클레임 ERD
---
erDiagram
    claim["클레임 claim"] {
        NUM claim_id PK "클레임번호"
        NUM order_id FK "주문번호"
        NUM seller_id FK "판매자번호"
        CODE claim_type_cd "클레임유형코드"
        CODE claim_status_cd "클레임상태코드"
        CODE claim_reason_cd "클레임사유코드"
        NAME reason_detail "상세사유 (선택)"
        CODE fault_type_cd "귀책구분코드"
        CODE requested_by_type_cd "신청자구분코드"
        DT requested_at "신청일시"
        DT completed_at "완료일시 (선택)"
        AMT delivery_fee_refund_amount "배송비환불금액"
        AMT delivery_fee_charge_amount "배송비재부과금액"
        AMT claim_fee_amount "클레임비용"
        CODE claim_fee_settle_cd "클레임비용처리코드"
    }
    claim_item["클레임상품 claim_item"] {
        NUM claim_id PK, FK "클레임번호"
        NUM order_item_id PK, FK "주문상품번호"
        INT quantity "수량"
        AMT discount_refund_amount "할인회수금액"
        AMT point_refund_amount "적립금환원금액"
        NUM exchange_item_id FK "교환단품번호 (선택)"
        CODE inspect_result_cd "검수결과코드 (선택)"
    }
    claim_refund["클레임 환불 claim_refund"] {
        NUM claim_id PK, FK "클레임번호"
        NUM payment_id PK, FK "결제번호"
        AMT refund_amount "환불금액"
    }
    claim_status_hist["클레임 상태 이력 claim_status_hist"] {
        NUM status_hist_id PK "상태이력번호"
        NUM claim_id FK "클레임번호"
        CODE before_status_cd "이전상태코드 (선택)"
        CODE after_status_cd "변경상태코드"
        NAME change_reason "변경사유 (선택)"
        CODE changed_by_type_cd "처리자구분코드"
        NUM changed_by_id "처리자ID (선택)"
        DT changed_at "변경일시"
    }
    order_item["주문상품 (주문 회차) order_item"] {
        NUM order_item_id PK "주문상품번호"
    }
    order_seller["판매자 주문 (주문 회차) order_seller"] {
        NUM order_id PK "주문번호"
        NUM seller_id PK "판매자번호"
    }
    payment["결제 (결제·배송 회차) payment"] {
        NUM payment_id PK "결제번호"
    }
    payment_transaction["결제 거래 (결제·배송 회차) payment_transaction"] {
        NUM transaction_id PK "거래번호"
    }
    product_item["단품 (상품 회차) product_item"] {
        NUM item_id PK "단품번호"
    }
    shipment["배송 (결제·배송 회차) shipment"] {
        NUM shipment_id PK "배송번호"
    }
    order_seller ||..o{ claim : "클레임"
    claim ||--|{ claim_item : "클레임상품"
    order_item ||--o{ claim_item : "클레임상품"
    product_item |o..o{ claim_item : "교환 단품"
    claim ||..|{ claim_status_hist : "상태 이력"
    claim ||--o{ claim_refund : "환불 배분"
    payment ||--o{ claim_refund : "환불 배분"
    claim_refund |o..o{ payment_transaction : "환불 거래"
    claim |o..o{ payment : "클레임 비용 결제"
    claim |o..o{ shipment : "회수·재배송"
